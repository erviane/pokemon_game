source 'https://rubygems.org'

ruby '3.4.8'

gem 'rails', '~> 8.1.4'
gem 'pg'
gem 'puma'
gem 'sprockets-rails'
# Use SCSS for stylesheets (Dart Sass; sassc is unmaintained)
gem 'dartsass-sprockets'
gem 'jquery-rails'
gem 'jbuilder'
# No longer a default gem since Ruby 3.4; used by db/seeds.rb
gem 'csv'

gem 'chartkick'
# Indonesian defaults for validation messages, dates and numbers
gem 'rails-i18n'

gem 'will_paginate', '~> 4.0'

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem 'tzinfo-data', platforms: %i[windows jruby]

group :development, :test do
  gem 'debug', platforms: %i[mri windows]
end

group :development do
  gem 'web-console'
  gem 'listen'
  gem 'better_errors'
  gem 'binding_of_caller'
end
