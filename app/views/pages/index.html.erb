<section class="hero mb-4">
  <div class="row align-items-center g-4">
    <div class="col-lg-5 text-center text-lg-start">
      <%= image_tag "logo.png", alt: "Pokemon" %>
      <p class="lead mt-3 mb-0"><%= t(".tagline") %></p>
      <div class="d-flex gap-2 mt-3 justify-content-center justify-content-lg-start">
        <%= link_to new_pokemon_battle_path, class: "btn btn-light" do %><i class="bi bi-lightning-charge-fill text-danger"></i> <%= t(".start_battle") %><% end %>
        <%= link_to new_pokemon_path, class: "btn btn-outline-light" do %><i class="bi bi-plus-lg"></i> <%= t(".new_pokemon") %><% end %>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="row g-3">
        <% @counts.each do |label, (count, path)| %>
          <div class="col-6">
            <%= link_to path, class: "kpi" do %>
              <div class="value"><%= number_with_delimiter(count) %></div>
              <div class="label"><%= t(".counts.#{label}") %></div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<div class="card mb-4">
  <div class="card-body">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <h2 class="h5 fw-bold mb-0"><%= t(".statistics_by_element") %></h2>
      <%= type_badge(@element_type) %>
    </div>
    <div class="type-pills">
      <% Skill::ELEMENT_TYPE.each do |type| %>
        <%= link_to type, root_path(element_type: type), class: ["type-badge", "type-#{type.downcase}", ("active" if type == @element_type)] %>
      <% end %>
    </div>
  </div>
</div>

<div class="row g-4">
  <% { most_wins: [@most_win_pokemon, "trophy"],
       most_losses: [@most_lose_pokemon, "emoji-frown"],
       most_used_skills: [@most_used_skill, "magic"],
       most_picked: [@most_pokemon_picked, "hand-index-thumb"],
       most_surrenders: [@most_surrender_pokemon, "flag"] }.each_with_index do |(key, (data, icon)), i| %>
    <div class="<%= i == 4 ? 'col-12' : 'col-lg-6' %>">
      <div class="card h-100">
        <div class="card-header"><i class="bi bi-<%= icon %> me-1"></i> <%= t(".top5", title: t(".charts.#{key}")) %></div>
        <div class="card-body"><%= column_chart data, height: "260px" %></div>
      </div>
    </div>
  <% end %>
</div>
