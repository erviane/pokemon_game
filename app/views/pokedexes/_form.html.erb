<%= form_for pokedex do |f| %>
  <div class="row g-3">
    <div class="col-md-6">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: ["form-control", ("is-invalid" if pokedex.errors[:name].any?)] %>
      <%= field_error(pokedex, :name) %>
    </div>
    <div class="col-md-6">
      <%= f.label :element_type, class: "form-label" %>
      <%= select_tag('pokedex[element_type]', options_with_placeholder(t(".select_element_type"), @pokedex_select, @pokedex.element_type), required: true, id: "pokedex_element_type", class: ["form-select", ("is-invalid" if pokedex.errors[:element_type].any?)]) %>
      <%= field_error(pokedex, :element_type) %>
    </div>
    <% %i[base_health_point base_attack base_defence base_speed].each do |attr| %>
      <div class="col-6 col-md-3">
        <%= f.label attr, class: "form-label" %>
        <%= f.number_field attr, class: ["form-control", ("is-invalid" if pokedex.errors[attr].any?)] %>
        <%= field_error(pokedex, attr) %>
      </div>
    <% end %>
    <div class="col-12">
      <%= f.label :image_url, class: "form-label" %>
      <%= f.url_field :image_url, class: ["form-control", ("is-invalid" if pokedex.errors[:image_url].any?)], placeholder: "https://…" %>
      <%= field_error(pokedex, :image_url) %>
    </div>
    <div class="col-12"><%= f.submit t(".submit"), class: "btn btn-primary" %></div>
  </div>
<% end %>
