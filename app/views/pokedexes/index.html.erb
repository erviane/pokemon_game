<%= page_header t("common.pokedex"), { t("common.pokedex") => nil } do %>
  <%= link_to new_pokedex_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg"></i> <%= t(".new_pokedex") %><% end %>
<% end %>

<%= render "shared/search", path: pokedexes_path, placeholder: t("search.placeholders.pokedexes"), collection: @pokedexes,
           filters: [[:type, t("search.all_types"), Skill::ELEMENT_TYPE.map { |type| [type, type] }]] %>

<% if @pokedexes.empty? %>
  <div class="card"><div class="empty-state"><i class="bi bi-search"></i><%= t("search.no_results") %></div></div>
<% end %>
<div class="row g-4">
  <% @pokedexes.each do |pokedex| %>
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card card-hover h-100">
        <div class="card-body d-flex flex-column">
          <div class="d-flex justify-content-between align-items-start">
            <span class="small fw-bold text-body-secondary">#<%= pokedex.id.to_s.rjust(3, "0") %></span>
            <%= type_badge(pokedex.element_type) %>
          </div>
          <%= link_to pokedex do %>
            <%= image_tag pokedex.image_url, class: "sprite my-2", alt: pokedex.name, loading: "lazy" %>
          <% end %>
          <h3 class="h6 fw-bold text-capitalize mb-2"><%= link_to pokedex.name, pokedex, class: "text-reset text-decoration-none" %></h3>
          <div class="mini-stats mb-3">
            <div><small><%= t("common.hp") %></small><strong><%= pokedex.base_health_point %></strong></div>
            <div><small><%= t("common.atk") %></small><strong><%= pokedex.base_attack %></strong></div>
            <div><small><%= t("common.def") %></small><strong><%= pokedex.base_defence %></strong></div>
          </div>
          <div class="d-flex gap-2 mt-auto">
            <%= link_to edit_pokedex_path(pokedex), class: "btn btn-sm btn-outline-secondary flex-fill", "aria-label": t("common.edit_name", name: pokedex.name) do %><i class="bi bi-pencil"></i><% end %>
            <%= link_to pokedex, class: "btn btn-sm btn-outline-danger flex-fill", method: :delete, data: { confirm: t("common.are_you_sure") }, "aria-label": t("common.delete_name", name: pokedex.name) do %><i class="bi bi-trash"></i><% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
<%= will_paginate @pokedexes, inner_window: 1, outer_window: 0 %>
