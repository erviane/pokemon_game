<%= page_header @pokedex.name.capitalize, { t("common.pokedex") => pokedexes_path, @pokedex.name.capitalize => nil } do %>
  <%= link_to edit_pokedex_path(@pokedex), class: "btn btn-outline-secondary" do %><i class="bi bi-pencil"></i> <%= t("common.edit") %><% end %>
  <%= link_to @pokedex, class: "btn btn-outline-danger", method: :delete, data: { confirm: t("common.are_you_sure") } do %><i class="bi bi-trash"></i> <%= t("common.delete") %><% end %>
<% end %>

<div class="row g-4">
  <div class="col-md-5 col-lg-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="sprite-wrap"><%= image_tag @pokedex.image_url, class: "sprite-lg", alt: @pokedex.name %></div>
        <div class="d-flex justify-content-between align-items-center mt-3">
          <span class="fw-bold text-body-secondary">#<%= @pokedex.id.to_s.rjust(3, "0") %></span>
          <%= type_badge(@pokedex.element_type) %>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-7 col-lg-8">
    <div class="card h-100">
      <div class="card-header"><%= t(".base_stats") %></div>
      <div class="card-body">
        <% %i[base_health_point base_attack base_defence base_speed].each do |attr| %>
          <% label, value = Pokedex.human_attribute_name(attr), @pokedex.public_send(attr) %>
          <div class="mb-3">
            <div class="d-flex justify-content-between small mb-1"><span class="fw-semibold"><%= label %></span><span class="fw-bold"><%= value %></span></div>
            <div class="progress" style="height: .6rem" role="progressbar" aria-label="<%= label %>" aria-valuenow="<%= value %>" aria-valuemin="0" aria-valuemax="255">
              <div class="progress-bar" style="width: <%= [value.to_i * 100 / 255, 100].min %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="card mt-4" id="learnset">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><%= t(".learnset") %></span>
    <span class="badge text-bg-light"><%= @learnset.size %></span>
  </div>
  <div class="table-responsive">
    <table class="table table-modern table-hover">
      <thead>
        <tr>
          <th class="col-fit"><%= t(".learn_level") %></th>
          <th><%= t("common.skill") %></th>
          <th class="col-fit"><%= t("common.type") %></th>
          <th class="col-fit"><%= t("common.power") %></th>
          <th class="col-fit"><span class="visually-hidden"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @learnset.each do |entry| %>
          <tr>
            <td class="text-end"><%= entry.learn_level %></td>
            <td class="text-start fw-semibold text-capitalize"><%= ref_link entry.skill.name, skill_path(entry.skill) %></td>
            <td class="text-start"><%= type_badge(entry.skill.element_type) %></td>
            <td class="text-end"><%= entry.skill.power %></td>
            <td class="text-center">
              <%= link_to pokedex_pokedex_skill_path(@pokedex, entry), method: :delete, data: { confirm: t("common.are_you_sure") }, class: "btn btn-sm btn-outline-danger", title: t(".remove_skill"), "aria-label": t(".remove_skill") do %><i class="bi bi-x-lg"></i><% end %>
            </td>
          </tr>
        <% end %>
        <% if @learnset.empty? %>
          <tr><td colspan="5" class="text-center text-body-secondary py-4"><%= t(".no_learnset") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-body border-top">
    <%= form_with url: pokedex_pokedex_skills_path(@pokedex) do %>
      <div class="row g-2 align-items-end">
        <div class="col-md">
          <%= label_tag :skill_id, t("common.skill"), class: "form-label small fw-semibold" %>
          <%= select_tag :skill_id, options_with_placeholder(t("pokemons.show.choose_skill"), @skill_select), class: "form-select", required: true %>
        </div>
        <div class="col-6 col-md-auto">
          <%= label_tag :learn_level, t(".unlock_level"), class: "form-label small fw-semibold" %>
          <div class="input-group" style="max-width: 9rem">
            <span class="input-group-text">Lv</span>
            <%= number_field_tag :learn_level, @learnset.empty? ? 1 : nil, min: 1, step: 1, class: "form-control", required: true, placeholder: "1", "aria-describedby": "learn_level_help" %>
          </div>
        </div>
        <div class="col-6 col-md-auto">
          <%= submit_tag t(".add_skill"), class: "btn btn-primary w-100 text-nowrap" %>
        </div>
      </div>
      <div id="learn_level_help" class="form-text"><%= t(".unlock_level_help") %></div>
    <% end %>
  </div>
</div>
