<%= page_header t(".title", id: params[:pokemon_battle_id]), { t("common.battles") => pokemon_battles_path, "##{params[:pokemon_battle_id]}" => pokemon_battle_path(params[:pokemon_battle_id]), t(".log") => nil } %>
<%= render "shared/search", path: pokemon_battle_pokemon_battle_logs_path(params[:pokemon_battle_id]), placeholder: t("search.placeholders.pokemon_battle_logs"), collection: @pokemon_battle_logs,
           filters: [[:action_type, t("search.all_actions"), [[t("pokemon_battle_logs.table_log.attack"), "attack"], [t("pokemon_battle_logs.table_log.surrender"), "surrender"]]]] %>
<div id="battle_log" data-frame>
  <div class="card"><%= render 'pokemon_battle_logs/table_log', sortable: true, anchor: "battle_log" %></div>
  <%= will_paginate @pokemon_battle_logs, inner_window: 1, outer_window: 0 %>
</div>
