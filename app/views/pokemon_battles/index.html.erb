<%= page_header t("common.battles"), { t("common.battles") => nil } do %>
  <%= link_to new_pokemon_battle_path, class: "btn btn-primary" do %><i class="bi bi-lightning-charge-fill"></i> <%= t(".new_battle") %><% end %>
<% end %>

<%= render "shared/search", path: pokemon_battles_path, placeholder: t("search.placeholders.pokemon_battles"), collection: @pokemon_battles,
           filters: [[:state, t("search.all_states"), [[t(".ongoing"), "ongoing"], [t(".finished"), "finish"]]],
                     [:mode, t("search.all_modes"), PokemonBattle::BATTLE_TYPES.map { |mode| [t(mode, scope: :battle_types), mode] }]] %>

<div id="battles_table" data-frame>
<div class="card">
  <div class="table-responsive">
    <table class="table table-modern table-hover">
      <thead>
        <tr>
          <%= sort_header t(".match"), "match" %>
          <%= sort_header t(".mode"), "mode", fit: true %>
          <%= sort_header t(".turn"), "turn", fit: true %>
          <%= sort_header t(".status"), "status", fit: true %>
          <%= sort_header t(".winner"), "winner" %>
          <%= sort_header t(".xp"), "xp", fit: true %>
          <th class="col-fit"><%= t("common.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @pokemon_battles.each do |pokemon_battle| %>
          <tr>
            <td class="text-start text-nowrap">
              <span class="fw-semibold">
                <%= image_tag pokemon_battle.pokemon1.pokedex.image_url, class: "sprite-sm", alt: "" %>
                <%= ref_link pokemon_battle.pokemon1.name, pokemon_path(pokemon_battle.pokemon1) %>
                <span class="text-body-secondary mx-1 small"><%= t("common.vs").downcase %></span>
                <%= ref_link pokemon_battle.pokemon2.name, pokemon_path(pokemon_battle.pokemon2) %>
                <%= image_tag pokemon_battle.pokemon2.pokedex.image_url, class: "sprite-sm", alt: "" %>
              </span>
            </td>
            <td class="text-start small text-body-secondary text-nowrap"><%= t(pokemon_battle.battle_type, scope: :battle_types, default: pokemon_battle.battle_type) %></td>
            <td class="text-end"><%= pokemon_battle.current_turn %></td>
            <td class="text-start">
              <% if pokemon_battle.state == "finish" %>
                <span class="badge rounded-pill text-bg-secondary"><%= t(".finished") %></span>
              <% else %>
                <span class="badge rounded-pill text-bg-success"><%= t(".ongoing") %></span>
              <% end %>
            </td>
            <td class="text-start fw-semibold"><%= pokemon_battle.pokemon_winner_id ? ref_link(pokemon_battle.winner, pokemon_path(pokemon_battle.pokemon_winner_id)) : "—" %></td>
            <td class="text-end"><%= pokemon_battle.experience_gain || "—" %></td>
            <td class="text-center text-nowrap">
              <%= link_to pokemon_battle_pokemon_battle_logs_path(pokemon_battle), class: "btn btn-sm btn-outline-secondary", title: t("common.battle_log"), "aria-label": t("common.battle_log") do %><i class="bi bi-journal-text"></i><% end %>
              <%= link_to pokemon_battle, class: "btn btn-sm btn-outline-danger", method: :delete, data: { confirm: t("common.are_you_sure") }, "aria-label": t(".delete_battle") do %><i class="bi bi-trash"></i><% end %>
              <%= link_to pokemon_battle, class: "btn btn-sm btn-dark" do %><%= t(".open") %> <i class="bi bi-arrow-right"></i><% end %>
            </td>
          </tr>
        <% end %>
        <% if @pokemon_battles.empty? %>
          <tr><td colspan="7"><div class="empty-state"><i class="bi bi-lightning-charge"></i><%= params[:q].present? || params[:state].present? || params[:mode].present? ? t("search.no_results") : t(".empty") %></div></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<%= will_paginate @pokemon_battles, inner_window: 1, outer_window: 0 %>
</div>
