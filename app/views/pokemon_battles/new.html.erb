<%= page_header t(".title"), { t("common.battles") => pokemon_battles_path, t("common.new") => nil } %>

<% if @pokemon_select.size < 2 %>
  <div class="alert alert-info">
    <%= t(".need_two") %>
    <%= link_to t(".create_pokemon"), new_pokemon_path, class: "alert-link" %><% if @fainted_count > 0 %> <%= t(".or") %> <%= link_to t(".heal_all"), heal_all_path, class: "alert-link" %><% end %>.
  </div>
<% elsif @fainted_count > 0 %>
  <p class="small text-body-secondary"><i class="bi bi-info-circle"></i> <%= t(".fainted", count: @fainted_count) %> <%= link_to t(".fainted_heal"), heal_all_path %> <%= t(".fainted_suffix") %></p>
<% end %>

<%= form_for @pokemon_battle do |f| %>
  <div class="arena">
    <div class="row g-4 align-items-center">
      <% [["pokemon1_id", t(".pokemon_n", n: 1)], ["pokemon2_id", t(".pokemon_n", n: 2)]].each_with_index do |(field, label), i| %>
        <div class="col-md-5 <%= 'order-md-3' if i == 1 %>">
          <div class="battle-select text-center">
            <div class="battle-preview" data-preview-for="<%= field %>">
              <%# Pokeball artwork: Pixabay (pixabay.com/vectors/monster-ball-pokemon-pokeball-game-8084507), Pixabay Content License %>
              <%= image_tag "pokeball.png", class: "battle-placeholder", alt: "", data: { preview_icon: true } %>
              <img class="d-none" alt="" data-preview-img>
            </div>
            <div class="battle-preview-type" data-preview-type="<%= field %>"></div>
            <h2 class="h5 fw-bold mt-2"><%= label %></h2>
            <%= label_tag field, t(".choose", label: label), class: "visually-hidden" %>
            <%= select_tag(field, options_with_placeholder(t(".select_pokemon"), @pokemon_select, params[field].presence&.to_i), class: "form-select mt-3", required: true, data: { battle_pick: true }) %>
            <% if @pokemon_battle.errors[field].any? %>
              <div class="invalid-feedback d-block"><%= @pokemon_battle.errors[field].join(', ') %></div>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="col-md-2 order-md-2"><div class="vs-badge"><%= t("common.vs") %></div></div>
    </div>
  </div>

  <div class="row g-3 mt-2">
    <%# The English mode name is the submitted value (stored as battle_type and read by BattleEngine); only the label is translated. %>
    <% [["Manual Battle", "btn-primary", "controller"],
        ["Player VS AI", "btn-success", "cpu"],
        ["Auto Battle", "btn-danger", "fast-forward-fill"]].each do |mode, tone, icon| %>
      <div class="col-md-4">
        <div class="card h-100"><div class="card-body d-flex flex-column">
          <div class="fw-bold"><i class="bi bi-<%= icon %>"></i> <%= t(mode, scope: :battle_types) %></div>
          <p class="small text-body-secondary flex-grow-1 mb-3"><%= t(mode, scope: "pokemon_battles.new.hints") %></p>
          <%= button_tag t(mode, scope: :battle_types), name: "commit", value: mode, class: "btn #{tone} w-100" %>
        </div></div>
      </div>
    <% end %>
  </div>
<% end %>
