<%= page_header t(".title", id: @pokemon_battle.id), { t("common.battles") => pokemon_battles_path, "##{@pokemon_battle.id}" => nil } do %>
  <span class="badge rounded-pill text-bg-light border align-self-center px-3 py-2"><%= t(@pokemon_battle.battle_type, scope: :battle_types, default: @pokemon_battle.battle_type) %></span>
<% end %>

<% if @pokemon_battle.state == "finish" %>
  <div class="alert alert-warning d-flex align-items-center gap-2">
    <i class="bi bi-trophy-fill fs-4"></i>
    <div>
      <strong><%= t(".finished") %></strong>
      <% if @pokemon_battle.pokemon_winner_id.present? %>
        <% winner = ref_link(@pokemon_battle.winner, pokemon_path(@pokemon_battle.pokemon_winner_id)) %>
        <%= @pokemon_battle.experience_gain ? t(".winner_xp_html", name: winner, xp: @pokemon_battle.experience_gain) : t(".winner_html", name: winner) %>
      <% end %>
    </div>
    <div class="ms-auto d-flex gap-2">
      <%= link_to t(".heal_all"), heal_all_path, class: "btn btn-sm btn-outline-success" %>
      <%= link_to new_pokemon_battle_path, class: "btn btn-sm btn-dark" do %><i class="bi bi-lightning-charge-fill"></i> <%= t(".new_battle") %><% end %>
    </div>
  </div>
<% end %>

<div class="arena mb-4">
  <div class="row g-4 align-items-center">
    <div class="col-md-5">
      <%= render 'fighter', pokemon: @pokemon1, skills: @pokemon1_skills, turn_active: @pokemon_battle.current_turn.odd? %>
    </div>
    <div class="col-md-2 text-center">
      <div class="vs-badge"><%= t("common.vs") %></div>
      <div class="fw-bold mt-3"><%= t(".turn", turn: @pokemon_battle.current_turn) %></div>
    </div>
    <div class="col-md-5">
      <%= render 'fighter', pokemon: @pokemon2, skills: @pokemon2_skills, turn_active: @pokemon_battle.current_turn.even? %>
    </div>
  </div>
</div>

<div id="battle_log" data-frame>
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-journal-text"></i> <%= t("common.battle_log") %></span>
    <% if @pokemon_battle_logs.total_entries > @pokemon_battle_logs.per_page %>
      <%= link_to t(".view_all"), pokemon_battle_pokemon_battle_logs_path(@pokemon_battle), class: "small" %>
    <% end %>
  </div>
  <%= render 'pokemon_battle_logs/table_log', sortable: true, anchor: "battle_log" %>
</div>
<%= will_paginate @pokemon_battle_logs, inner_window: 1, outer_window: 0 %>
</div>
