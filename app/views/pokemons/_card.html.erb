<div class="col-sm-6 col-lg-4 col-xl-3">
  <div class="card card-hover h-100">
    <div class="card-body d-flex flex-column">
      <div class="d-flex justify-content-between align-items-start">
        <%= type_badge(pokemon.pokedex.element_type) %>
        <span class="level-chip"><%= t("common.level", level: pokemon.level) %></span>
      </div>
      <%= link_to show_path do %>
        <%= image_tag pokemon.pokedex.image_url, class: "sprite my-2", alt: pokemon.pokedex.name, loading: "lazy" %>
      <% end %>
      <h3 class="h6 fw-bold mb-0"><%= link_to pokemon.name, show_path, class: "text-reset text-decoration-none" %></h3>
      <div class="small text-body-secondary text-capitalize mb-2"><%= ref_link pokemon.pokedex.name, pokedex_path(pokemon.pokedex) %></div>
      <%= hp_bar(pokemon.current_health_point, pokemon.max_health_point) %>
      <div class="mini-stats my-3">
        <div><small><%= t("common.atk") %></small><strong><%= pokemon.attack %></strong></div>
        <div><small><%= t("common.def") %></small><strong><%= pokemon.defence %></strong></div>
        <div><small><%= t("common.spd") %></small><strong><%= pokemon.speed %></strong></div>
      </div>
      <div class="small text-body-secondary mb-3"><i class="bi bi-star"></i> <%= t("common.xp", count: pokemon.current_experience) %></div>
      <div class="d-flex gap-2 mt-auto">
        <%= link_to heal_path(pokemon), class: "btn btn-sm btn-outline-success flex-fill" do %><i class="bi bi-heart-pulse"></i> <%= t("common.heal") %><% end %>
        <%= link_to show_path, class: "btn btn-sm btn-dark flex-fill" do %><%= t("common.details") %> <i class="bi bi-arrow-right"></i><% end %>
      </div>
    </div>
  </div>
</div>
