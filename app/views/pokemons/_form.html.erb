<%= form_for pokemon do |f| %>
  <div class="row g-3">
    <div class="col-md-6">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, value: @pokemon.name, class: ["form-control", ("is-invalid" if @pokemon.errors[:name].any?)], placeholder: t(".name_placeholder") %>
      <%= field_error(@pokemon, :name) %>
    </div>
    <div class="col-md-6">
      <%= f.label :pokedex_id, class: "form-label" %>
      <%= select_tag('pokemon[pokedex_id]', options_with_placeholder(t(".select_pokedex"), @pokedex_select, @pokemon.pokedex_id), required: true, class: ["form-select", ("is-invalid" if @pokemon.errors[:pokedex_id].any?)]) %>
      <%= field_error(@pokemon, :pokedex_id) %>
    </div>
    <div class="col-12">
      <%= submit_tag t(".submit"), class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
