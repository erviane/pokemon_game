<%= form_for @pokemon do |f| %>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="sprite-wrap">
        <%= image_tag pokemon.pokedex.image_url, class: "sprite-lg", alt: pokemon.pokedex.name %>
        <div class="mt-2"><%= type_badge(pokemon.pokedex.element_type) %></div>
      </div>
    </div>
    <div class="col-md-8">
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
          <%= field_error(@pokemon, :name) %>
        </div>
        <div class="col-md-3">
          <%= f.label :pokedex, class: "form-label" %>
          <%= f.text_field :pokedex_id, value: @pokemon.pokedex.name, class: "form-control text-capitalize", disabled: true %>
        </div>
        <div class="col-md-3">
          <%= f.label :level, class: "form-label" %>
          <%= f.text_field :level, class: "form-control", disabled: true %>
        </div>
        <% %i[max_health_point current_health_point attack defence speed].each do |attr| %>
          <div class="col-md-4">
            <%= f.label attr, class: "form-label" %>
            <%= f.number_field attr, class: ["form-control", ("is-invalid" if @pokemon.errors[attr].any?)] %>
            <%= field_error(@pokemon, attr) %>
          </div>
        <% end %>
        <div class="col-12">
          <%= f.submit t(".submit"), class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
