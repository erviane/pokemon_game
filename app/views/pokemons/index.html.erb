<%= page_header t("common.pokemon"), { t("common.pokemon") => nil } do %>
  <%= link_to heal_all_path, class: "btn btn-outline-success" do %><i class="bi bi-heart-pulse"></i> <%= t("common.heal_all") %><% end %>
  <%= link_to new_pokemon_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg"></i> <%= t(".new_pokemon") %><% end %>
<% end %>

<%= render "shared/search", path: pokemons_path, placeholder: t("search.placeholders.pokemons"), collection: @pokemons,
           filters: [[:type, t("search.all_types"), Skill::ELEMENT_TYPE.map { |type| [type, type] }]] %>

<% if @pokemons.any? %>
  <div class="row g-4">
    <% @pokemons.each do |pokemon| %>
      <%= render 'pokemons/card', pokemon: pokemon, show_path: pokemon_path(pokemon) %>
    <% end %>
  </div>
  <%= will_paginate @pokemons, inner_window: 1, outer_window: 0 %>
<% else %>
  <div class="card"><div class="empty-state"><i class="bi bi-stars"></i><%= params[:q].present? || params[:type].present? ? t("search.no_results") : t(".empty") %></div></div>
<% end %>
