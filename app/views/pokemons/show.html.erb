<%= page_header @pokemon.name, { t("common.pokemon") => pokemons_path, @pokemon.name => nil } do %>
  <%= link_to heal_path(@pokemon), class: "btn btn-outline-success" do %><i class="bi bi-heart-pulse"></i> <%= t("common.heal") %><% end %>
  <%= link_to edit_pokemon_path(@pokemon), class: "btn btn-outline-secondary" do %><i class="bi bi-pencil"></i> <%= t("common.edit") %><% end %>
  <%= link_to @pokemon, class: "btn btn-outline-danger", method: :delete, data: { confirm: t("common.are_you_sure") } do %><i class="bi bi-trash"></i> <%= t("common.delete") %><% end %>
<% end %>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="sprite-wrap mb-3">
          <%= image_tag @pokemon.pokedex.image_url, class: "sprite-lg", alt: @pokemon.pokedex.name %>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3">
          <%= type_badge(@pokemon.pokedex.element_type) %>
          <span class="level-chip"><%= t("common.level", level: @pokemon.level) %></span>
        </div>
        <%= hp_bar(@pokemon.current_health_point, @pokemon.max_health_point) %>
        <div class="row g-2 mt-3 text-center">
          <div class="col-6"><div class="p-2 rounded-3 bg-success-subtle"><div class="small text-success-emphasis"><%= t(".wins") %></div><div class="fw-bold fs-5"><%= @number_of_win %></div></div></div>
          <div class="col-6"><div class="p-2 rounded-3 bg-danger-subtle"><div class="small text-danger-emphasis"><%= t(".losses") %></div><div class="fw-bold fs-5"><%= @number_of_lose %></div></div></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card mb-4">
      <div class="card-header"><%= t(".stats") %></div>
      <div class="card-body py-2">
        <%= stat_row Pokemon.human_attribute_name(:pokedex), ref_link(@pokemon.pokedex.name.capitalize, pokedex_path(@pokemon.pokedex)) %>
        <%= stat_row Pokemon.human_attribute_name(:max_health_point), @pokemon.max_health_point %>
        <%= stat_row Pokemon.human_attribute_name(:attack), @pokemon.attack %>
        <%= stat_row Pokemon.human_attribute_name(:defence), @pokemon.defence %>
        <%= stat_row Pokemon.human_attribute_name(:speed), @pokemon.speed %>
        <%= stat_row t(".experience"), t("common.xp", count: @pokemon.current_experience) %>
      </div>
    </div>

    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><%= t("common.skills") %></span>
        <span class="badge text-bg-light"><%= @pokemon.pokemon_skills.count %> / 4</span>
      </div>
      <div class="table-responsive" id="table_skill" data-frame>
        <table class="table table-modern table-hover">
          <thead>
            <tr>
              <%= sort_header t("common.skill"), "name", anchor: "table_skill" %>
              <%= sort_header t("common.type"), "type", fit: true, anchor: "table_skill" %>
              <%= sort_header t("common.power"), "power", fit: true, anchor: "table_skill" %>
              <%= sort_header t("common.pp"), "pp", fit: true, anchor: "table_skill" %>
              <th class="col-fit"><span class="visually-hidden"><%= t("common.actions") %></span></th></tr>
          </thead>
          <tbody>
            <% @skill_rows.each do |f| %>
              <tr>
                <td class="text-start fw-semibold text-capitalize"><%= ref_link f.skill_name, skill_path(f.skill_id) %></td>
                <td class="text-start"><%= type_badge(f.skill_element_type) %></td>
                <td class="text-end"><%= f.skill_power %></td>
                <td class="text-end text-nowrap"><%= f.current_pp %> / <%= f.skill_max_pp %></td>
                <td class="text-center">
                  <%= link_to pokemon_skill_destroy_path(@pokemon, f), method: :delete, data: { confirm: t(".forget_confirm", pokemon: @pokemon.name, skill: f.skill_name) }, class: "btn btn-sm btn-outline-danger", title: t(".remove_skill"), "aria-label": t(".remove_skill") do %><i class="bi bi-x-lg"></i><% end %>
                </td>
              </tr>
            <% end %>
            <% if @pokemon.pokemon_skills.empty? %>
              <tr><td colspan="5" class="text-center text-body-secondary py-4"><%= t(".no_skills") %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="card-body border-top">
        <% if @pokemon.pokemon_skills.size >= 4 %>
          <p class="small text-body-secondary mb-0"><i class="bi bi-info-circle"></i> <%= t(".skills_full", name: @pokemon.name) %></p>
        <% else %>
          <%= form_for([@pokemon, @pokemon.pokemon_skills.build], html: { class: "d-flex gap-2" }) do %>
            <%= select_tag('skill_id', options_with_placeholder(t(".choose_skill"), @skill_list), class: "form-select", required: true, "aria-label": t("common.skill")) %>
            <%= submit_tag t(".learn"), class: "btn btn-primary text-nowrap" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
