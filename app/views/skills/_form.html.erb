<%= form_for skill do |f| %>
  <div class="row g-3">
    <div class="col-md-6">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, class: ["form-control", ("is-invalid" if skill.errors[:name].any?)] %>
      <%= field_error(skill, :name) %>
    </div>
    <div class="col-md-6">
      <%= f.label :element_type, class: "form-label" %>
      <%= select_tag('skill[element_type]', options_with_placeholder(t(".select_element_type"), @skill_select, skill.element_type), required: true, id: "skill_element_type", class: ["form-select", ("is-invalid" if skill.errors[:element_type].any?)]) %>
      <%= field_error(skill, :element_type) %>
    </div>
    <% %i[power max_pp].each do |attr| %>
      <div class="col-md-6">
        <%= f.label attr, class: "form-label" %>
        <%= f.number_field attr, class: ["form-control", ("is-invalid" if skill.errors[attr].any?)] %>
        <%= field_error(skill, attr) %>
      </div>
    <% end %>
    <div class="col-12"><%= f.submit t(".submit"), class: "btn btn-primary" %></div>
  </div>
<% end %>
