<%= page_header t("common.skills"), { t("common.skills") => nil } do %>
  <%= link_to new_skill_path, class: "btn btn-primary" do %><i class="bi bi-plus-lg"></i> <%= t(".new_skill") %><% end %>
<% end %>

<%= render "shared/search", path: skills_path, placeholder: t("search.placeholders.skills"), collection: @skills,
           filters: [[:type, t("search.all_types"), Skill::ELEMENT_TYPE.map { |type| [type, type] }]] %>

<div id="skills_table" data-frame>
<div class="card">
  <div class="table-responsive">
    <table class="table table-modern table-hover">
      <thead>
        <tr>
          <%= sort_header t("common.name"), "name" %>
          <%= sort_header t("common.type"), "type", fit: true %>
          <%= sort_header t("common.power"), "power", fit: true %>
          <%= sort_header t("common.max_pp"), "max_pp", fit: true %>
          <th class="col-fit"><%= t("common.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @skills.each do |skill| %>
          <tr>
            <td class="text-start fw-semibold text-capitalize"><%= link_to skill.name, skill, class: "text-reset text-decoration-none" %></td>
            <td class="text-start"><%= type_badge(skill.element_type) %></td>
            <td class="text-end"><%= skill.power %></td>
            <td class="text-end"><%= skill.max_pp %></td>
            <td class="text-center text-nowrap">
              <%= link_to edit_skill_path(skill), class: "btn btn-sm btn-outline-secondary", "aria-label": t("common.edit_name", name: skill.name) do %><i class="bi bi-pencil"></i><% end %>
              <%= link_to skill, class: "btn btn-sm btn-outline-danger", method: :delete, data: { confirm: t("common.are_you_sure") }, "aria-label": t("common.delete_name", name: skill.name) do %><i class="bi bi-trash"></i><% end %>
            </td>
          </tr>
        <% end %>
        <% if @skills.empty? %>
          <tr><td colspan="5"><div class="empty-state"><i class="bi bi-search"></i><%= t("search.no_results") %></div></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<%= will_paginate @skills, inner_window: 1, outer_window: 0 %>
</div>
