<%= page_header @skill.name.capitalize, { t("common.skills") => skills_path, @skill.name.capitalize => nil } do %>
  <%= link_to edit_skill_path(@skill), class: "btn btn-outline-secondary" do %><i class="bi bi-pencil"></i> <%= t("common.edit") %><% end %>
  <%= link_to @skill, class: "btn btn-outline-danger", method: :delete, data: { confirm: t("common.are_you_sure") } do %><i class="bi bi-trash"></i> <%= t("common.delete") %><% end %>
<% end %>

<div class="row g-4">
  <% { t("common.type") => type_badge(@skill.element_type), t("common.power") => @skill.power, t("common.max_pp") => @skill.max_pp }.each do |label, value| %>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="small text-body-secondary fw-semibold text-uppercase"><%= label %></div>
        <div class="fs-3 fw-bold mt-1"><%= value %></div>
      </div></div>
    </div>
  <% end %>
</div>
